# Public URL — Cloudflare Tunnel で公開する FQDN
# OAuth redirect URI のホストに埋め込まれるため、Cloudflare の Public hostname と完全一致させる
PUBLIC_BASE_URL=https://stg-ap.market-river.net

# Database (production と必ず分離)
POSTGRES_USER=altpocket_staging
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=altpocket_staging
DATABASE_URL=postgres://altpocket_staging:replace_with_strong_password@db:5432/altpocket_staging?sslmode=disable

# App secrets (generate with: openssl rand -hex 32, production と必ず別値)
SESSION_SECRET=replace_with_random_hex
JWT_SECRET=replace_with_random_hex

# Google OAuth (staging 用に新規作成した Client)
GOOGLE_WEB_CLIENT_ID=replace_with_staging_web_client_id
GOOGLE_CLIENT_SECRET=replace_with_staging_web_client_secret
GOOGLE_EXT_CLIENT_ID=replace_with_staging_extension_client_id

# CORS (APP_ENV=production では必須)
CORS_ALLOW_ORIGINS=https://stg-ap.market-river.net,chrome-extension://replace_with_staging_extension_id

# production と同条件で動作確認するため production 固定を推奨
APP_ENV=production

# API port bind — Cloudflare Tunnel が到達するポート
# 既定は loopback (127.0.0.1:18080) で同ホストのみ到達可
# 別マシンの cloudflared から来る場合はサーバの LAN IP に上書きする
# STAGING_API_BIND=192.168.1.50
# STAGING_API_PORT=18080

# Optional content limits
CONTENT_FULL_LIMIT_BYTES=1000000
CONTENT_SEARCH_LIMIT_BYTES=16384
